{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Culinary Admin",
  "version": "0.1.6",
  "identifier": "mx.culinaryrestaurant.admin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5180",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Culinary Admin", "width": 1440, "height": 900, "minWidth": 360, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'"
    }
  },
  "bundle": { "active": true, "publisher": "Culinary", "copyright": "© 2026 Culinary", "shortDescription": "Culinary Admin, por PizzaDev", "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
